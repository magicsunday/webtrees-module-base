includes:
    - %currentWorkingDirectory%/.build/vendor/magicsunday/coding-standard/phpstan/base.neon
    # Opt-in phpat preset: only the structural rules in tests/Architecture/ArchitectureTest.php,
    # which Deptrac cannot express. Layer dependencies are enforced by Deptrac (deptrac.yaml).
    - %currentWorkingDirectory%/.build/vendor/magicsunday/coding-standard/phpstan/phpat.neon

parameters:
    # level: max and the rule packs (strict, deprecation, phpunit) come from the shared base.
    phpVersion:
        min: 80300
        max: 80500

    tmpDir: %currentWorkingDirectory%/.build/cache/.phpstan.cache

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/tests/

    excludePaths:
        - %currentWorkingDirectory%/.build/

    ignoreErrors:
        # Library-export traits: consumed by downstream modules, not within module-base itself.
        - identifier: trait.unused
          paths:
              - %currentWorkingDirectory%/src/Facade/ModuleAwareDataFacadeTrait.php
              - %currentWorkingDirectory%/src/Facade/RouteAwareDataFacadeTrait.php

services:
    -
        class: MagicSunday\Webtrees\ModuleBase\Test\Architecture\ArchitectureTest
        tags:
            - phpat.test
