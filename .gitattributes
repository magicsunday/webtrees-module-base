# Exclude from distribution archives (composer --prefer-dist, git archive)
/.coderabbit.yaml      export-ignore
/.editorconfig         export-ignore
/.github/              export-ignore
.gitattributes         export-ignore
.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/.phplint.yml          export-ignore
/phpstan.neon          export-ignore
/phpunit.xml           export-ignore
/rector.php            export-ignore
.jscpd.json            export-ignore
/tests/                export-ignore
/AGENTS.md             export-ignore
/deptrac.yaml          export-ignore
/node_modules/         export-ignore
/package.json          export-ignore
/package-lock.json     export-ignore

# The catalogue fixtures are read byte for byte. The compiled catalogues are binary and
# the sources keep LF, except the fixture that carries CRLF on purpose.
*.mo                                                  binary
/tests/fixtures/catalogues/**/*.po                    text eol=lf
/tests/fixtures/catalogues/crlf-line-endings/**/*.po  -text
