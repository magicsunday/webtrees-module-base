{
    "name": "magicsunday/webtrees-module-base",
    "description": "Shared PHP base classes (date, name, image, place processors plus module helpers) for the magicsunday/webtrees-* chart modules.",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "keywords": [
        "webtrees",
        "module",
        "library",
        "genealogy",
        "php",
        "processor",
        "shared"
    ],
    "authors": [
        {
            "name": "Rico Sonntag",
            "email": "mail@ricosonntag.de",
            "homepage": "https://ricosonntag.de",
            "role": "Developer"
        }
    ],
    "config": {
        "bin-dir": ".build/bin",
        "vendor-dir": ".build/vendor",
        "discard-changes": true,
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "policy": {
            "advisories": {
                "ignore": {
                    "guzzlehttp/guzzle": "Transitive dependency of the required fisharebest/webtrees, which pins it exactly. VersionInformation drives it on a runtime network path (the release-version check), but the module declares no direct guzzle constraint and the admin's webtrees install governs the version. New guzzle CVEs still surface via composer audit, and advisories on any other package still block resolution.",
                    "symfony/cache": "Transitive dev/test dependency exact-pinned by fisharebest/webtrees (stable 2.2.6 pins 7.4.8); the module ships no symfony/cache and the admin's webtrees install governs the upgrade. Advisories on any unpinned package still block resolution.",
                    "league/commonmark": "Transitive dev/test dependency exact-pinned by fisharebest/webtrees across the 2.2.x range; the module ships no commonmark and the admin's webtrees install governs the upgrade. Advisories on any unpinned package still block resolution.",
                    "symfony/mailer": "Transitive dev/test dependency exact-pinned by fisharebest/webtrees (stable 2.2.6 pins 7.4.8); the module ships no symfony/mailer and the admin's webtrees install governs the upgrade. Advisories on any unpinned package still block resolution.",
                    "nesbot/carbon": "Transitive dev/test dependency exact-pinned by fisharebest/webtrees across the 2.2.x range; the module ships no nesbot/carbon and the admin's webtrees install governs the upgrade. Advisories on any unpinned package still block resolution."
                }
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "8.3 - 8.5",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "fisharebest/webtrees": "~2.2.0"
    },
    "require-dev": {
        "infection/infection": "^0.34",
        "magicsunday/coding-standard": "^2.3",
        "phpat/phpat": "^0.12.4"
    },
    "autoload": {
        "psr-4": {
            "MagicSunday\\Webtrees\\ModuleBase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MagicSunday\\Webtrees\\ModuleBase\\Test\\": "tests/"
        }
    },
    "scripts": {
        "ci:cgl": [
            "php-cs-fixer fix --config .php-cs-fixer.dist.php --diff --verbose"
        ],
        "ci:rector": [
            "rector process --config rector.php"
        ],
        "ci:test:php:cgl": [
            "@ci:cgl --dry-run"
        ],
        "ci:test:php:deptrac": [
            "deptrac analyse --no-progress",
            "deptrac debug:unassigned",
            "@php -r \"is_dir('.build') || mkdir('.build', 0777, true);\"",
            "deptrac analyse --no-progress --formatter=graphviz-dot --output=.build/deptrac-layers.dot",
            "check-deptrac-cycles.php .build/deptrac-layers.dot"
        ],
        "ci:test:php:lint": [
            "phplint --configuration .phplint.yml"
        ],
        "ci:test:php:phpat-subjects": [
            "check-phpat-subjects.php ."
        ],
        "ci:test:php:psr4": [
            "composer dump-autoload --optimize --strict-psr"
        ],
        "ci:test:php:phpstan": [
            "phpstan analyze --configuration phpstan.neon --memory-limit=-1"
        ],
        "ci:test:php:rector": [
            "@ci:rector --dry-run"
        ],
        "ci:test:php:templates": [
            "check-consumer-config.php ."
        ],
        "ci:test:php:unit": [
            "phpunit --configuration phpunit.xml --display-all-issues"
        ],
        "ci:test:php:unit:coverage": [
            "XDEBUG_MODE=coverage phpunit --configuration phpunit.xml --display-all-issues --coverage-html .build/coverage/"
        ],
        "ci:test:php:infection": [
            "XDEBUG_MODE=coverage infection --threads=max --no-progress --no-interaction"
        ],
        "ci:test": [
            "@ci:test:php:lint",
            "@ci:test:php:psr4",
            "@ci:test:php:phpstan",
            "@ci:test:php:phpat-subjects",
            "@ci:test:php:rector",
            "@ci:test:php:unit",
            "@ci:test:php:cpd",
            "@ci:test:php:cgl",
            "@ci:test:php:templates",
            "@ci:test:php:deptrac"
        ],
        "ci:test:php:cpd": [
            "npx jscpd --config .jscpd.json --skip-comments --no-tips"
        ],
        "post-install-cmd": [
            "npm install jscpd@^5.0.11"
        ],
        "post-update-cmd": [
            "npm install jscpd@^5.0.11"
        ]
    }
}
