declare(strict_types=1);

/**
 * The detail panel of a tree chart. The panel script of the chart library looks up the parts
 * by their data-panel attribute, so the markup keeps all of them. The view writes the shared rules
 * of the panel in a style element of its own, so they are in the document from the first paint.
 *
 * @var string $id              The element id of the panel
 * @var string $moduleClass     The class that the module sets for its own styling
 * @var string $closeLabel      The translated label of the close button
 * @var string $hint            The translated hint shown while no person is selected
 * @var string $emptyText       The translated text shown for a person without details
 * @var string $individualLabel The translated label of the button that opens the individual page
 * @var string $centerLabel     The translated label of the button that centers the chart
 */

?>
<style>
/*
 * A round image of fixed size with a ring around it. The whole photo stays visible, so a portrait
 * photo keeps the chin, and the neutral ground fills what the photo does not cover.
 */
.webtrees-detail-panel .detail-image {
    display: block;
    width: 9rem;
    height: 9rem;
    margin: 0 auto 1rem;
    border: 3px solid var(--bs-border-color, #dee2e6);
    border-radius: 50%;
    background-color: var(--bs-secondary-bg, #e9ecef);
    object-fit: contain;
}

.webtrees-detail-panel .detail-image[hidden] {
    display: none;
}

.webtrees-detail-panel .detail-facts dt {
    font-weight: 600;
    margin-top: 0.75rem;
}

.webtrees-detail-panel .detail-facts dd {
    margin-bottom: 0;
}

.webtrees-detail-panel .detail-place {
    font-style: italic;
}

.webtrees-detail-panel .offcanvas-title:focus {
    outline: none;
}

/*
 * The panel is an offcanvas that opens on a click on a person. It has no backdrop, so the chart
 * stays usable, and the shadow to the chart makes it look as if it lies above the page.
 */
.webtrees-detail-panel.offcanvas-end {
    box-shadow: -0.75rem 0 1.5rem rgba(0, 0, 0, 0.25);
}

/* In a right-to-left page the panel sits at the left edge, so the shadow falls to the right */
[dir="rtl"] .webtrees-detail-panel.offcanvas-end {
    box-shadow: 0.75rem 0 1.5rem rgba(0, 0, 0, 0.25);
}
</style>
        <aside id="<?php echo e($id); ?>"
               class="offcanvas offcanvas-end webtrees-detail-panel d-print-none <?php echo e($moduleClass); ?>"
               tabindex="-1"
               aria-labelledby="<?php echo e($id); ?>-title"
               hidden>
            <div class="offcanvas-header">
                <h2 class="offcanvas-title h5" id="<?php echo e($id); ?>-title" data-panel="title" tabindex="-1"></h2>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="<?php echo e($closeLabel); ?>"></button>
            </div>
            <div class="offcanvas-body">
                <img class="detail-image" data-panel="image" alt="" hidden>
                <p class="text-muted" data-panel="hint"><?php echo e($hint); ?></p>
                <dl class="detail-facts mb-0" data-panel="facts"></dl>
                <p class="text-muted" data-panel="empty" hidden><?php echo e($emptyText); ?></p>
                <div class="d-grid gap-2 mt-3" data-panel="actions" hidden>
                    <button type="button" class="btn btn-primary btn-sm" data-panel="individual"><?php echo e($individualLabel); ?></button>
                    <button type="button" class="btn btn-outline-primary btn-sm" data-panel="center"><?php echo e($centerLabel); ?></button>
                </div>
            </div>
        </aside>
