declare(strict_types=1);

/**
 * The help button of a chart toolbar with its popover. The page script of the chart library
 * toggles the popover and shows the rows of the active mode.
 *
 * @var string                                                     $id         The element id of the popover
 * @var string                                                     $label      The translated text for the button title and the popover region
 * @var list<array{key: string, text: string, mode?: string}>      $rows       The translated rows, a row with a mode belongs to that mode only
 * @var string|null                                                $activeMode The mode whose rows start visible
 */

?>

<div class="position-relative d-inline-block">
    <button type="button"
            class="btn-primary btn-chart btn-help"
            title="<?php echo e($label); ?>"
            aria-expanded="false"
            aria-controls="<?php echo e($id); ?>"
    >
        <span class="icon">
            <svg class="svg-inline--fa fa-fw" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512">
                <!--!Font Awesome Free 6.6.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fonticons, Inc.-->
                <path fill="currentColor" d="M80 160c0-35.3 28.7-64 64-64l32 0c35.3 0 64 28.7 64 64l0 3.6c0 21.8-11.1 42.1-29.4 53.8l-42.2 27.1c-25.2 16.2-40.4 44.1-40.4 74l0 1.4c0 17.7 14.3 32 32 32s32-14.3 32-32l0-1.4c0-8.2 4.2-15.8 11-20.2l42.2-27.1c36.6-23.6 58.8-64.1 58.8-107.7l0-3.6c0-70.7-57.3-128-128-128l-32 0C73.3 32 16 89.3 16 160c0 17.7 14.3 32 32 32s32-14.3 32-32zm80 320a40 40 0 1 0 0-80 40 40 0 1 0 0 80z"/>
            </svg>
        </span>
    </button>
    <div id="<?php echo e($id); ?>" role="region" aria-label="<?php echo e($label); ?>" class="help-popover d-none position-absolute top-100 end-0 mt-2 p-3 bg-white border rounded shadow-sm" style="min-width: min(400px, calc(100vw - 2rem)); max-width: calc(100vw - 2rem); z-index: 1000;">
        <table class="table table-sm table-borderless mb-0">
            <?php foreach ($rows as $row) { ?>
                <?php $mode = $row['mode'] ?? null; ?>
                <tr<?php echo $mode !== null ? ' data-help-mode="' . e($mode) . '"' : ''; ?><?php echo (($mode !== null) && ($mode !== $activeMode)) ? ' class="d-none"' : ''; ?>><td><strong><?php echo e($row['key']); ?></strong></td><td><?php echo e($row['text']); ?></td></tr>
            <?php } ?>
        </table>
    </div>
</div>
